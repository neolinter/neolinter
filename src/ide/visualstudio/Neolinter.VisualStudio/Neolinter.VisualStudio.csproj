<Project Sdk="Microsoft.NET.Sdk">

  <!-- VisualStudio.Extensibility: the extension runs out of process; the project builds the .vsix. Windows only,
       so it is not part of Neolinter.slnx (built by the visualstudio job in .github/workflows/ci.yml). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <RootNamespace>Neolinter.VisualStudio</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neolinter.EditorConfig\Neolinter.EditorConfig.csproj" />
  </ItemGroup>

  <!-- Remote UI: the XAML is parsed by Visual Studio at runtime, not compiled. -->
  <ItemGroup>
    <Page Remove="**\*.xaml" />
    <EmbeddedResource Include="**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\vscode\resources\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" IncludeInVSIX="true" />
    <Content Include="..\..\..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" IncludeInVSIX="true" />
  </ItemGroup>

</Project>
