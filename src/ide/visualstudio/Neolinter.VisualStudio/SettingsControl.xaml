<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
  <DataTemplate.Resources>
    <DataTemplate x:Key="textOption">
      <StackPanel Margin="0,6,0,0">
        <Label Content="{Binding Title}" />
        <TextBox Text="{Binding Value, Mode=TwoWay}" MinWidth="120" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.7" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="choiceOption">
      <StackPanel Margin="0,6,0,0">
        <Label Content="{Binding Title}" />
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}" MinWidth="120" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.7" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="rule">
      <Border BorderThickness="1" Padding="12" Margin="0,0,0,12"
              BorderBrush="Gray">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,6" />
          <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="Enabled" />
          <Label Content="Severity" />
          <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity, Mode=TwoWay}" MinWidth="120" HorizontalAlignment="Left" />
          <ItemsControl ItemsSource="{Binding TextOptions}" ItemTemplate="{StaticResource textOption}" />
          <ItemsControl ItemsSource="{Binding ChoiceOptions}" ItemTemplate="{StaticResource choiceOption}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </DataTemplate.Resources>
  <ScrollViewer>
    <StackPanel Margin="16" TextElement.Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}">
      <!-- Tab strip: "Solution analysis" stays disabled until the Visual Studio runner exists. -->
      <StackPanel Orientation="Horizontal">
        <Button Content="Settings" Padding="12,4" />
        <Button Content="Solution analysis" Padding="12,4" Margin="8,0,0,0" IsEnabled="False" ToolTip="Coming soon" />
      </StackPanel>
      <TextBlock Text="{Binding Location}" Margin="0,12,0,0" Opacity="0.7" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PackageBanner}" Margin="0,8,0,0" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Rules}" ItemTemplate="{StaticResource rule}" Margin="0,12,0,0" />
      <TextBlock Text="{Binding Status}" Margin="0,4,0,0" />
    </StackPanel>
  </ScrollViewer>
</DataTemplate>
