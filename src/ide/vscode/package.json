{
  "name": "neolinter",
  "displayName": "Neolinter",
  "description": "Settings screen for Neolinter rules, stored in the workspace .editorconfig.",
  "version": "0.1.0",
  "publisher": "neolinter",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neolinter/neolinter"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neolinter.openSettings",
        "title": "Open Settings",
        "category": "Neolinter",
        "icon": {
          "light": "resources/icons/neolinter-light.svg",
          "dark": "resources/icons/neolinter-dark.svg"
        }
      }
    ],
    "configuration": {
      "title": "Neolinter",
      "properties": {
        "neolinter.cli.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `neolinter` executable used by the Solution analysis tab. Empty: use the local tool manifest, then the global tool."
        },
        "neolinter.cli.projectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `Neolinter.Cli.csproj`, run with `dotnet run --project` when no installed tool is found (useful until the package is published)."
        }
      }
    }
  },
  "scripts": {
    "embed-rules": "node scripts/embed-rules.mjs",
    "compile": "npm run embed-rules && tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "node -e \"require('fs').copyFileSync('../../../LICENSE', 'LICENSE')\" && vsce package",
    "vscode:prepublish": "npm run compile",
    "build-icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
