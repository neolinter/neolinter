<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>neolinter</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>neolinter</ToolCommandName>
    <PackageId>Neolinter.Cli</PackageId>
    <Description>Neolinter command line: on-demand solution-wide analyses (dead code, duplicated code) with SARIF output.</Description>
    <PackageTags>linter;csharp;sarif;dead-code;duplicates</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neolinter.Cli.Core\Neolinter.Cli.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neolinter.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
