<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <Version>0.1.0</Version>
    <Authors>The Neolinter Authors</Authors>
    <Copyright>Copyright (c) 2026 The Neolinter Authors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/neolinter/neolinter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neolinter/neolinter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
