<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sandbox to try the rules live in an IDE. Not part of Neolinter.slnx. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- An executable, so the dead-code analysis has an entry point to start from. -->
    <OutputType>Exe</OutputType>
    <!-- The point is to see Neolinter diagnostics, not to fail on them. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Loads the analyzers straight from the build output, the same way the NuGet package does. -->
    <ProjectReference Include="..\..\src\dotnet\Neolinter.Analyzers\Neolinter.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\dotnet\Neolinter.CodeFixes\Neolinter.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
