# Neolinter settings for the playground. Edit by hand or with "Neolinter: Open Settings".

[*.cs]
dotnet_diagnostic.NLR0001.severity = warning
nlr0001.min_statements = 3
dotnet_diagnostic.NLR0004.severity = warning
dotnet_diagnostic.NLR0005.severity = warning
dotnet_diagnostic.NLR0007.severity = warning
